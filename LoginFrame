package ui;

import auth.AuthService;

import javax.swing.*;
import java.awt.*;

public class LoginFrame extends JFrame {

    private JTextField emailField;
    private JPasswordField passwordField;

    public LoginFrame() {
        setTitle("Secure Password Manager");
        setSize(400, 250);
        setDefaultCloseOperation(EXIT_ON_CLOSE);
        setLocationRelativeTo(null);

        JPanel panel = new JPanel(new GridLayout(5, 1, 10, 10));
        panel.setBorder(BorderFactory.createEmptyBorder(20, 20, 20, 20));

        emailField = new JTextField();
        passwordField = new JPasswordField();

        JButton registerBtn = new JButton("Register");
        JButton loginBtn = new JButton("Login");

        panel.add(new JLabel("Email:"));
        panel.add(emailField);
        panel.add(new JLabel("Master Password:"));
        panel.add(passwordField);

        JPanel buttonPanel = new JPanel();
        buttonPanel.add(registerBtn);
        buttonPanel.add(loginBtn);

        add(panel, BorderLayout.CENTER);
        add(buttonPanel, BorderLayout.SOUTH);

        registerBtn.addActionListener(e -> register());
        loginBtn.addActionListener(e -> login());
    }

    private void register() {
        try {
            AuthService.register(emailField.getText(), new String(passwordField.getPassword()));
            JOptionPane.showMessageDialog(this, "Account created successfully.");
        } catch (Exception ex) {
            JOptionPane.showMessageDialog(this, "Error creating account.");
        }
    }

    private void login() {
        try {
            boolean success = AuthService.login(
                    emailField.getText(),
                    new String(passwordField.getPassword())
            );

            if (success) {
                new VaultFrame(emailField.getText()).setVisible(true);
                dispose();
            } else {
                JOptionPane.showMessageDialog(this, "Invalid credentials.");
            }
        } catch (Exception ex) {
            JOptionPane.showMessageDialog(this, "Login error.");
        }
    }
}
