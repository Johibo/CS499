package ui;

import vault.VaultService;

import javax.swing.*;
import java.awt.*;

public class VaultFrame extends JFrame {

    private String user;
    private JTextArea vaultArea;

    public VaultFrame(String user) {

        this.user = user;

        setTitle("Password Vault - " + user);
        setSize(500, 500);
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        setLayout(new BorderLayout());

        JPanel topPanel = new JPanel();

        JButton generateBtn = new JButton("Generate Password");
        JButton addBtn = new JButton("Add Credential");
        JButton editBtn = new JButton("Edit Credential");
        JButton deleteBtn = new JButton("Delete Credential");
        JButton refreshBtn = new JButton("Refresh Vault");

        topPanel.add(generateBtn);
        topPanel.add(addBtn);
        topPanel.add(editBtn);
        topPanel.add(deleteBtn);
        topPanel.add(refreshBtn);

        add(topPanel, BorderLayout.NORTH);

        vaultArea = new JTextArea();
        vaultArea.setEditable(false);

        JScrollPane scrollPane = new JScrollPane(vaultArea);
        add(scrollPane, BorderLayout.CENTER);

        generateBtn.addActionListener(e -> generatePassword());
        addBtn.addActionListener(e -> addCredential());
        editBtn.addActionListener(e -> editCredential());
        deleteBtn.addActionListener(e -> deleteCredential());
        refreshBtn.addActionListener(e -> refreshVault());

        refreshVault();

        setVisible(true);
    }

    private void refreshVault() {

        try {
            vaultArea.setText(VaultService.getFormattedVault(user));
        } catch (Exception e) {
            vaultArea.setText("Error loading vault.");
        }
    }

    private void generatePassword() {

        String password = VaultService.generatePassword(12);

        JOptionPane.showMessageDialog(
                this,
                "Generated Password:\n" + password
        );
    }

    private void addCredential() {

        JTextField site = new JTextField();
        JTextField username = new JTextField();
        JTextField password = new JTextField();

        Object[] fields = {
                "Site:", site,
                "Username:", username,
                "Password:", password
        };

        int result = JOptionPane.showConfirmDialog(
                this,
                fields,
                "Add Credential",
                JOptionPane.OK_CANCEL_OPTION
        );

        if (result == JOptionPane.OK_OPTION) {

            try {

                VaultService.addCredential(
                        user,
                        site.getText(),
                        username.getText(),
                        password.getText()
                );

                refreshVault();

            } catch (Exception e) {

                JOptionPane.showMessageDialog(
                        this,
                        "Error adding credential."
                );
            }
        }
    }

    private void editCredential() {

        String indexStr = JOptionPane.showInputDialog(
                this,
                "Enter credential ID to edit:"
        );

        try {

            int index = Integer.parseInt(indexStr);

            JTextField site = new JTextField();
            JTextField username = new JTextField();
            JTextField password = new JTextField();

            Object[] fields = {
                    "Site:", site,
                    "Username:", username,
                    "Password:", password
            };

            int result = JOptionPane.showConfirmDialog(
                    this,
                    fields,
                    "Edit Credential",
                    JOptionPane.OK_CANCEL_OPTION
            );

            if (result == JOptionPane.OK_OPTION) {

                VaultService.editCredential(
                        user,
                        index,
                        site.getText(),
                        username.getText(),
                        password.getText()
                );

                refreshVault();
            }

        } catch (Exception ex) {

            JOptionPane.showMessageDialog(
                    this,
                    "Invalid credential ID."
            );
        }
    }

    private void deleteCredential() {

        String indexStr = JOptionPane.showInputDialog(
                this,
                "Enter credential ID to delete:"
        );

        try {

            int index = Integer.parseInt(indexStr);

            int confirm = JOptionPane.showConfirmDialog(
                    this,
                    "Are you sure you want to delete this credential?",
                    "Confirm Delete",
                    JOptionPane.YES_NO_OPTION
            );

            if (confirm == JOptionPane.YES_OPTION) {

                VaultService.deleteCredential(user, index);

                refreshVault();
            }

        } catch (Exception ex) {

            JOptionPane.showMessageDialog(
                    this,
                    "Invalid credential ID."
            );
        }
    }
}
